{
  "name": "chronokeepers",
  "version": "1.0.0",
  "description": "Хранители Времени: Квантовый Сдвиг",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.clockgame.chronokeepers",
    "productName": "Хранители Времени",
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "files": ["main.js", "assets/**/*"],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Хранители Времени"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
